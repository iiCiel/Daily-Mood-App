{
  "expo": {
    "name": "Daily Mood",
    "slug": "mood-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "mood-journal",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EBE1"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Daily Mood needs photo access so you can attach photos to mood entries.",
        "NSCameraUsageDescription": "Daily Mood needs camera access so you can take photos for mood entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0EBE1"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.iiciel.moodjournal"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Daily Mood to access your photos.",
          "cameraPermission": "Allow Daily Mood to use your camera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cd610bd-40a4-4248-b3e2-2eb85e097440"
      }
    },
    "owner": "lolaangelo"
  }
}
