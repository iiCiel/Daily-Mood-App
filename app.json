{
  "expo": {
    "name": "mood",
    "slug": "mood-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "mood-journal",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EBE1"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can add them to your mood entries.",
        "NSCameraUsageDescription": "We need camera access so you can take photos for your mood entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0EBE1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.iiciel.moodjournal"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mood Journal to access your photos.",
          "cameraPermission": "Allow Mood Journal to use your camera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf88895e-3ce4-4edb-930b-0f8637e1d522"
      }
    }
  }
}
